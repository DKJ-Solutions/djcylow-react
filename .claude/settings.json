{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git rebase:*)",
      "Bash(git push origin +:*)",
      "PowerShell(git push origin +:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)"
    ],
    "ask": [
      "Edit(./next.config.ts)",
      "Write(./next.config.ts)",
      "Edit(./netlify.toml)",
      "Write(./netlify.toml)",
      "Edit(./public/images/**)",
      "Write(./public/images/**)",
      "Bash(gh api -X:*)",
      "PowerShell(gh api -X:*)",
      "Bash(gh api --method:*)",
      "PowerShell(gh api --method:*)",
      "Bash(gh release create:*)",
      "PowerShell(gh release create:*)",
      "Bash(gh release delete:*)",
      "PowerShell(gh release delete:*)",
      "Bash(gh repo edit:*)",
      "PowerShell(gh repo edit:*)",
      "Bash(gh ruleset:*)",
      "PowerShell(gh ruleset:*)",
      "Bash(git config:*)",
      "PowerShell(git config:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "dkj-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DKJ-Solutions/dkj-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "dkj-policy@dkj-claude-plugins": true,
    "dkj-subagents-alpha@dkj-claude-plugins": true,
    "figma@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/statusline/dkj-progress.ps1\"",
    "refreshInterval": 2
  }
}
